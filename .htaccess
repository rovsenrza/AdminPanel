# Admin Panel Root .htaccess
DirectoryIndex main.html
# Prevent directory listing
# Options -Indexes

# Enable URL rewriting
RewriteEngine On

# Force HTTPS (uncomment in production)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Protect .env files
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# Allow access to static assets
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(admin/admin-assets|uploads)/.*$ - [L]

# Allow direct access to backend PHP files that exist
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^backend/.*\.php$ - [L]

# Route other /backend/* requests to backend/index.php
RewriteCond %{REQUEST_URI} ^/backend/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^backend/(.*)$ backend/index.php [QSA,L]

# --- Admin Panel Routes ---
# /admin -> admin/index.html
RewriteRule ^admin/?$ admin/index.html [L]

# /admin/login -> admin/login.html
RewriteRule ^admin/login/?$ admin/login.html [L]

# /admin/page -> admin/page.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/admin/
RewriteRule ^admin/([^/]+)/?$ admin/$1.html [L]

# Serve HTML files directly (if accessed with .html extension)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule \.(html|css|js|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot)$ - [L]
